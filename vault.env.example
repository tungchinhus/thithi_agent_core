# Biến môi trường CHỈ cho dịch vụ Privacy Vault trên máy AI local. Sao chép thành vault.env.
# Gateway không được nạp file này: Gateway không có khoá nên không mở được kho ánh xạ.

# Phải trùng PRIVACY_SERVICE_TOKEN trong .env của Gateway.
PRIVACY_SERVICE_TOKEN=
# Tạo khoá: python -c "from thithi.privacy.vault import SqliteVault; print(SqliteVault.generate_key())"
# Mất khoá = không tái tạo được dữ liệu đang xử lý.
PRIVACY_VAULT_KEY=
PRIVACY_VAULT_DB=/app/vault/vault.db
PRIVACY_CONFIG=config/privacy.yaml
# Danh bạ tên đã biết (CSV name,kind), ghi đè known_names trong privacy.yaml.
PRIVACY_KNOWN_NAMES=/app/vault/danh_ba.csv
# Nhật ký truy cập Vault (che/tái tạo/xoá theo trace_id và người dùng; không chứa giá trị).
PRIVACY_ACCESS_LOG=/app/vault/access.jsonl
LOCAL_LLM_URL=http://ai-local:8000/v1
LOCAL_LLM_MODEL=local-model
