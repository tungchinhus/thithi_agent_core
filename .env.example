# Chỉ máy Gateway cần khoá này. Không đặt nó trên máy AI local hay MCP server.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high

LOCAL_LLM_URL=http://ai-local:8000/v1
LOCAL_LLM_MODEL=local-model
# Privacy Vault (chạy trên máy AI local). Gateway gọi qua PRIVACY_URL; chỉ Vault giữ ánh xạ.
PRIVACY_URL=http://privacy-vault:8090
PRIVACY_SERVICE_TOKEN=
# Tạo khoá: python -c "from thithi.privacy.vault import SqliteVault; print(SqliteVault.generate_key())"
# Mất khoá = không tái tạo được dữ liệu đang xử lý. Chỉ đặt trên máy AI local.
PRIVACY_VAULT_KEY=
PRIVACY_VAULT_DB=data/vault/vault.db
PRIVACY_CONFIG=config/privacy.yaml
# Chỉ dùng khi dev không có GPU: THITHI_ENV=dev và THITHI_NER=off (chạy Vault trong cùng tiến trình, không NER)
THITHI_ENV=
THITHI_NER=

THITHI_LABELS=config/labels.yaml
THITHI_ROLES=config/roles.yaml
THITHI_AGENTS=agents
THITHI_AUDIT_LOG=data/audit.jsonl
